# czsc_mi 一键安装配置模板（W104）
# 复制为 install.env 后按需修改，安装时：sudo ./install_czsc_mi.sh --config install.env
# 路径项留空即用脚本内默认值：BASE_DIR 默认 $HOME，其余相对它推导，任意机器通用。
# 注意：本文件由 shell 读取，值里写 $HOME 不会被展开，请留空或写绝对路径。

# ---------- 路径与用户 ----------
RUN_USER=ai_runner
BASE_DIR=
STOCK_DIR=
CZSC_MI_DIR=
VENV=
DATA_DIR=
DB_PATH=

# ---------- 仓库地址 ----------
CZSC_MI_REPO=ssh://git@ssh.github.com:443/zengjuly/czsc_mi.git
CZSC_MI_BRANCH=main
THS_REPO=https://gitee.com/HiThink-Tech/Financial-API.git
TDX_REPO=https://gh-proxy.org/https://github.com/oficcejo/tdx-api.git
HERMES_REPO=https://gh-proxy.org/https://github.com/NousResearch/hermes-agent.git/
# 源码已就位（如从离线包恢复）时设为 1 跳过 clone
SKIP_CLONE=0

# ---------- 行情数据凭据 ----------
# 同花顺 iFinD/富途 API key（敏感，脚本会写入 .stockrc 并设 600 权限）
HITHINK_FINANCE_API_KEY=
# 通达信本地数据目录（如使用 tdx_local 数据源）；留空用 <STOCK_DIR>/data/tdx_vipdoc
TDX_VIPDOC_DIR=

# ---------- Web ----------
WEB_PORT=18501
